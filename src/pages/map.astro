---
import SEOHead from "../components/layout/SEOHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { dispensaries } from "../data/dispensaries";

const title = (s: string) =>
  s.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

// Only dispensaries with verified coordinates can be plotted.
const plotted = dispensaries
  .filter((d) => typeof d.lat === "number" && typeof d.lng === "number")
  .map((d) => ({
    slug: d.slug,
    name: d.dba ?? d.name,
    town: d.city || title(d.town),
    address: d.address,
    lat: d.lat,
    lng: d.lng,
    active: d.licenseStatus === "active",
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const unplotted = dispensaries.length - plotted.length;
---

<html lang="en">
  <head>
    <SEOHead
      title="Map of Vermont Cannabis Dispensaries | VT Dispensary Directory"
      description={`Interactive map of ${plotted.length} licensed cannabis dispensaries across Vermont. Find the closest shop and get directions.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-6">
        <p class="section-label">Browse by location</p>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-brand-ink mb-3">Dispensary map</h1>
        <p class="text-brand-muted max-w-2xl">
          {plotted.length} licensed dispensaries with verified coordinates.
          {unplotted > 0 && ` ${unplotted} more are listed in the directory but not yet plotted, because we have not verified an address for them.`}
        </p>
      </section>

      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <div class="grid lg:grid-cols-3 gap-4">
          <div class="lg:col-span-2 card overflow-hidden">
            <div id="map" class="w-full h-[560px] bg-brand-border" data-points={JSON.stringify(plotted)}></div>
          </div>

          <div class="card p-0 overflow-hidden flex flex-col h-[560px]">
            <div class="p-4 border-b border-brand-border shrink-0">
              <label for="map-search" class="sr-only">Filter dispensaries</label>
              <input
                id="map-search"
                type="search"
                placeholder="Filter by name or town"
                class="w-full text-sm border border-brand-border rounded-lg px-3 py-2 bg-white"
              />
            </div>
            <ul id="map-list" class="overflow-y-auto flex-1 divide-y divide-brand-border/60">
              {plotted.map((d, i) => (
                <li>
                  <button
                    type="button"
                    class="map-item w-full text-left px-4 py-3 hover:bg-brand-cream transition-colors"
                    data-index={i}
                    data-name={d.name.toLowerCase()}
                    data-town={d.town.toLowerCase()}
                  >
                    <span class="block font-bold text-sm text-brand-ink">{d.name}</span>
                    <span class="block text-xs text-brand-muted">{d.town}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <p class="text-xs text-brand-muted mt-4">
          Hours and addresses are verified against each dispensary's Google Business Profile.
          Call ahead before travelling. Map data &copy; OpenStreetMap contributors.
        </p>
      </section>
    </main>
    <Footer />

    <script>
      import L from "leaflet";
      import "leaflet/dist/leaflet.css";

      const el = document.getElementById("map") as HTMLElement | null;
      if (el) {
        type Point = {
          slug: string; name: string; town: string; address: string | null;
          lat: number; lng: number; active: boolean;
        };
        const points = JSON.parse(el.dataset.points || "[]") as Point[];

        let map: L.Map | null = null;
        let markers: L.CircleMarker[] = [];

        // Leaflet must not be initialised while the container still measures zero
        // pixels wide: it bakes that size into the map pane and every later
        // invalidateSize leaves the tiles offset by half the real width. Wait for
        // a real width first, then build the map once.
        function init() {
          if (map || el!.clientWidth === 0) return;

          map = L.map(el!, { scrollWheelZoom: false });
          L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          }).addTo(map);

          markers = points.map((p) => {
            const marker = L.circleMarker([p.lat, p.lng], {
              radius: 7,
              weight: 2,
              color: "#ffffff",
              fillColor: p.active ? "#16a34a" : "#9ca3af",
              fillOpacity: 1,
            }).addTo(map!);

            marker.bindPopup(
              `<strong>${p.name}</strong><br>` +
              (p.address ? `${p.address}<br>` : "") +
              `${p.town}, VT<br>` +
              (p.active ? "" : "<em>Temporarily closed</em><br>") +
              `<a href="/dispensaries/${p.slug}/">View listing</a>`
            );
            return marker;
          });

          if (points.length) {
            map.fitBounds(
              L.latLngBounds(points.map((p) => [p.lat, p.lng] as [number, number])),
              { padding: [24, 24] }
            );
          } else {
            map.setView([43.95, -72.7], 8);
          }
        }

        new ResizeObserver(() => {
          if (!map) init();
          else map.invalidateSize();
        }).observe(el);
        init();

        document.querySelectorAll<HTMLElement>(".map-item").forEach((btn) => {
          btn.addEventListener("click", () => {
            if (!map) return;
            const i = Number(btn.dataset.index);
            const p = points[i];
            map.setView([p.lat, p.lng], 14);
            markers[i]?.openPopup();
          });
        });

        const search = document.getElementById("map-search") as HTMLInputElement | null;
        search?.addEventListener("input", () => {
          const q = search.value.trim().toLowerCase();
          document.querySelectorAll<HTMLElement>("#map-list li").forEach((li) => {
            const btn = li.querySelector<HTMLElement>(".map-item")!;
            const hit = !q || btn.dataset.name!.includes(q) || btn.dataset.town!.includes(q);
            li.style.display = hit ? "" : "none";
          });
        });
      }
    </script>
  </body>
</html>
