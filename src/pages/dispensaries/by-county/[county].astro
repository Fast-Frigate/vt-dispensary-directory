---
import SEOHead from "../../../components/layout/SEOHead.astro";
import Header from "../../../components/layout/Header.astro";
import Footer from "../../../components/layout/Footer.astro";
import DispensaryCard from "../../../components/directory/DispensaryCard.astro";
import { dispensaries } from "../../../data/dispensaries";

export function getStaticPaths() {
  const counties = [...new Set(dispensaries.map((d) => d.county))];
  return counties.map((county) => ({ params: { county } }));
}

const { county } = Astro.params;
const countyName = county.split("-").map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const countyDispensaries = dispensaries.filter((d) => d.county === county);
---

<html lang="en">
  <head>
    <SEOHead
      title={`${countyName} Cannabis Dispensaries | Vermont Dispensary Directory`}
      description={`Find all ${countyDispensaries.length} licensed cannabis dispensaries in ${countyName}, Vermont.`}
    />
  </head>
  <body>
    <Header />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-brand-green">Home</a> &rsaquo;
        <a href="/dispensaries/" class="hover:text-brand-green">Dispensaries</a> &rsaquo;
        <span class="text-gray-900">{countyName}</span>
      </nav>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Cannabis Dispensaries in {countyName}, Vermont
      </h1>
      <p class="text-gray-500 mb-10">
        {countyDispensaries.length} licensed {countyDispensaries.length === 1 ? "dispensary" : "dispensaries"}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {countyDispensaries.map((d) => <DispensaryCard dispensary={d} />)}
      </div>
    </main>
    <Footer />
  </body>
</html>
