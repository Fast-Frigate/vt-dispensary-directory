---
import SEOHead from "../components/layout/SEOHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { dispensaries } from "../data/dispensaries";

const totalCount = dispensaries.length;

const towns = [...new Set(dispensaries.map((d) => d.town))].sort();
const townCounts = towns.map((t) => ({
  slug: t,
  name: t.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
  count: dispensaries.filter((d) => d.town === t).length,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Vermont Dispensary Directory",
    url: "https://vtdispensarydirectory.com",
    description: "Vermont's independent cannabis dispensary directory. Find all licensed dispensaries statewide.",
  },
];
---

<html lang="en">
  <head>
    <SEOHead
      title="Vermont Cannabis Dispensary Directory | All Licensed VT Shops"
      description={`Find all ${totalCount} licensed cannabis dispensaries in Vermont. Browse by town, compare hours and menus, updated regularly.`}
      schema={schema}
    />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Header />

    <main>
      <!-- Hero -->
      <section class="bg-brand-ink text-white py-20 px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4">
            Vermont's Cannabis<br/>Dispensary Directory
          </h1>
          <p class="text-gray-400 text-lg mb-8">
            {totalCount} licensed dispensaries statewide. Independent, consumer-first, always free.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/dispensaries/" class="btn-primary text-base px-6 py-3">
              Browse All Dispensaries
            </a>
            <a href="/map/" class="inline-flex items-center px-6 py-3 border border-white/20 text-white rounded-lg font-semibold text-base hover:border-white transition-colors">
              View Map
            </a>
          </div>
        </div>
      </section>

      <!-- Stat bar -->
      <div class="bg-brand-orange text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap gap-6 text-sm font-semibold">
          <span>{totalCount} Licensed Dispensaries</span>
          <span>{towns.length} Vermont Towns</span>
          <span>Updated Regularly</span>
          <span>No Paid Placements</span>
        </div>
      </div>

      <!-- Browse by Town -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h2 class="text-2xl font-bold text-brand-ink mb-2">Browse by Town</h2>
        <p class="text-brand-muted mb-8">{towns.length} towns with licensed dispensaries</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          {townCounts.map(({ slug, name, count }) => (
            <a
              href={`/dispensaries/by-town/${slug}/`}
              class="card p-4 hover:border-brand-green hover:shadow-sm transition-all group"
            >
              <div class="font-semibold text-brand-ink group-hover:text-brand-green text-sm">{name}</div>
              <div class="text-xs text-brand-muted mt-1">{count} {count === 1 ? "dispensary" : "dispensaries"}</div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
