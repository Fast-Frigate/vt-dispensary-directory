---
import SEOHead from "../components/layout/SEOHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { dispensaries } from "../data/dispensaries";

const totalCount = dispensaries.length;

const towns = [...new Set(dispensaries.map((d) => d.town))].sort();
const townCounts = towns.map((t) => ({
  slug: t,
  name: t.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
  count: dispensaries.filter((d) => d.town === t).length,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Vermont Dispensary Directory",
    url: "https://vtdispensarydirectory.com",
    description: "Vermont's independent cannabis dispensary directory. Find all licensed dispensaries statewide.",
  },
];
---

<html lang="en">
  <head>
    <SEOHead
      title="Vermont Cannabis Dispensary Directory | All Licensed VT Shops"
      description={`Find all ${totalCount} licensed cannabis dispensaries in Vermont. Browse by town, compare hours and menus, updated regularly.`}
      schema={schema}
    />
  </head>
  <body>
    <Header />

    <main>

      <!-- Hero — black on cream, big type -->
      <section class="px-4 pt-16 pb-12 max-w-7xl mx-auto">
        <p class="section-label">vtdispensarydirectory.com</p>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight text-brand-ink leading-none mb-6 max-w-3xl">
          Vermont's Cannabis Dispensary Directory
        </h1>
        <p class="text-brand-muted text-lg mb-8 max-w-xl">
          {totalCount} licensed dispensaries statewide. Independent, consumer-first, always free.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/dispensaries/" class="btn-primary">Browse All Dispensaries</a>
          <a href="/map/" class="btn-secondary">View Map</a>
        </div>
      </section>

      <!-- Stat bar -->
      <div class="bg-brand-ink text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap gap-8 text-xs font-bold uppercase tracking-widest">
          <span>{totalCount} Licensed Dispensaries</span>
          <span>{towns.length} Vermont Towns</span>
          <span>Updated Regularly</span>
          <span>No Paid Placements</span>
        </div>
      </div>

      <!-- Browse by Town -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <p class="section-label">Browse by Location</p>
        <h2 class="text-3xl font-black text-brand-ink mb-8">Vermont Towns</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          {townCounts.map(({ slug, name, count }) => (
            <a
              href={`/dispensaries/by-town/${slug}/`}
              class="group flex flex-col p-4 bg-brand-paper rounded-xl border border-brand-border hover:border-brand-ink transition-all"
            >
              <span class="font-bold text-brand-ink group-hover:text-brand-green text-sm leading-tight">{name}</span>
              <span class="text-xs text-brand-muted mt-1">{count} {count === 1 ? "shop" : "shops"}</span>
            </a>
          ))}
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>
