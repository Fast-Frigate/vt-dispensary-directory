---
const nav = [
  { label: "Directory", href: "/dispensaries/" },
  { label: "Map", href: "/map/" },
  { label: "Strains", href: "/strains/" },
  { label: "VT Guide", href: "/vermont-cannabis-guide/" },
  { label: "News", href: "/news/" },
];

const current = Astro.url.pathname;
---

<header class="bg-brand-ink sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">

      <a href="/" class="font-black text-white text-lg tracking-tight hover:text-brand-orange transition-colors">
        VT DISPENSARY DIRECTORY
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {nav.map(({ label, href }) => (
          <a
            href={href}
            class={`px-3 py-1.5 rounded-full text-sm font-bold transition-colors ${
              current.startsWith(href)
                ? "bg-white text-brand-ink"
                : "text-gray-400 hover:text-white"
            }`}
          >
            {label}
          </a>
        ))}
      </nav>

      <a href="/dispensaries/" class="hidden md:inline-flex items-center px-4 py-1.5 bg-brand-green text-white rounded-full text-sm font-bold hover:bg-green-700 transition-colors">
        Find a Dispensary
      </a>

    </div>
  </div>
</header>
