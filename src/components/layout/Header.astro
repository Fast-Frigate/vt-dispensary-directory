---
const nav = [
  { label: "Directory", href: "/dispensaries/" },
  { label: "Map", href: "/map/" },
  { label: "Strains", href: "/strains/" },
  { label: "VT Guide", href: "/vermont-cannabis-guide/" },
  { label: "News", href: "/news/" },
];

const current = Astro.url.pathname;
---

<header class="bg-brand-ink sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">

      <a href="/" class="font-black text-white text-lg tracking-tight hover:text-brand-orange transition-colors">
        VT DISPENSARY DIRECTORY
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {nav.map(({ label, href }) => (
          <a
            href={href}
            class={`px-3 py-1.5 rounded-full text-sm font-bold transition-colors ${
              current.startsWith(href)
                ? "bg-white text-brand-ink"
                : "text-gray-400 hover:text-white"
            }`}
          >
            {label}
          </a>
        ))}
      </nav>

      <a href="/dispensaries/" class="hidden md:inline-flex items-center px-4 py-1.5 bg-brand-green text-white rounded-full text-sm font-bold hover:bg-green-700 transition-colors">
        Find a Dispensary
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-white"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg id="nav-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="nav-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

    </div>

    <nav id="nav-mobile" class="hidden md:hidden pb-4 border-t border-white/10 pt-3">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class={`block px-3 py-2.5 rounded-lg text-sm font-bold transition-colors ${
            current.startsWith(href) ? "bg-white text-brand-ink" : "text-gray-300 hover:bg-white/10"
          }`}
        >
          {label}
        </a>
      ))}
      <a href="/dispensaries/" class="block mt-2 px-3 py-2.5 bg-brand-green text-white rounded-lg text-sm font-bold text-center">
        Find a Dispensary
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-toggle");
    var menu = document.getElementById("nav-mobile");
    var open = document.getElementById("nav-icon-open");
    var close = document.getElementById("nav-icon-close");
    if (!btn || !menu) return;

    btn.addEventListener("click", function () {
      var isOpen = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden", isOpen);
      open.classList.toggle("hidden", !isOpen);
      close.classList.toggle("hidden", isOpen);
      btn.setAttribute("aria-expanded", String(!isOpen));
      btn.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
    });
  })();
</script>
