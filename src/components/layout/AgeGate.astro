---
import { MIN_AGE, GA4_ID } from "../../config/site";
---

{/* Deliberately a dismissible bar, not a blocking interstitial. The whole site
    depends on organic search, and gating the content behind a modal risks
    Googlebot indexing the gate instead of the directory. */}
<div
  id="age-gate"
  class="hidden fixed inset-x-0 bottom-0 z-50 bg-brand-ink text-white border-t border-white/10"
  role="region"
  aria-label={`Age ${MIN_AGE} and over confirmation`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <p class="text-sm text-gray-300 flex-1">
      <strong class="text-white">You must be {MIN_AGE} or older.</strong>
      Cannabis is legal for adults {MIN_AGE}+ in Vermont. This site lists licensed
      dispensaries for informational purposes and does not sell cannabis.
      {GA4_ID && <span> We also use analytics cookies to understand how the site is used.</span>}
      <a href="/privacy/" class="underline hover:text-white">Privacy</a> &middot;
      <a href="/terms/" class="underline hover:text-white">Terms</a>
    </p>
    <div class="flex gap-2 shrink-0">
      <button id="age-gate-accept" class="px-5 py-2.5 bg-brand-green text-white rounded-full font-bold text-sm hover:bg-green-700 transition-colors">
        I'm {MIN_AGE} or older
      </button>
      <button id="age-gate-decline" class="px-5 py-2.5 border border-white/30 text-white rounded-full font-bold text-sm hover:bg-white/10 transition-colors">
        Exit
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "vtdd-consent";
    var bar = document.getElementById("age-gate");
    if (!bar) return;
    if (localStorage.getItem(KEY) === "granted") return;

    bar.classList.remove("hidden");

    document.getElementById("age-gate-accept").addEventListener("click", function () {
      localStorage.setItem(KEY, "granted");
      bar.classList.add("hidden");
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", { analytics_storage: "granted" });
      }
    });

    document.getElementById("age-gate-decline").addEventListener("click", function () {
      window.location.href = "https://www.google.com";
    });
  })();
</script>
