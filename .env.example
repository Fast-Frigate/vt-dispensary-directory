# Build-time analytics configuration for Cloudflare Pages.
# Set these under Pages project > Settings > Environment variables, then redeploy.
# All three are optional; anything unset is simply not rendered.
PUBLIC_GA4_ID=
PUBLIC_CF_BEACON_TOKEN=
PUBLIC_GSC_VERIFICATION=

# Only used by scripts/fetch-gbp.mjs at authoring time. Not needed to build or deploy.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
